<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 home-screen widget. Values shown here are the picker preview; the app fills in real ones. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_drip"
            android:layout_width="52dp"
            android:layout_height="39dp"
            android:contentDescription="@string/widget_drip_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/drip_ok" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_sample_total"
                android:textColor="@color/hyd_ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/widget_sample_goal"
                android:textColor="@color/hyd_ink2"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/w_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:indeterminate="false"
        android:max="1000"
        android:progress="460"
        android:progressDrawable="@drawable/widget_progress" />

    <TextView
        android:id="@+id/w_add"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/widget_btn"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_sample_add"
        android:textColor="@color/hyd_btn_ink"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
